<h1 class="h3 mb-3">最終問題</h1>

<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<div class="card">
  <div class="card-body">
    <%= form_with url: answer_path, method: :post, local: true do |f| %>
      <div class="mb-3">
        <%= f.label :answer, "見つけた3語のフレーズを入力してください", class: "form-label" %>
        <%= f.text_field :answer, name: "answer", class: "form-control" %>
      </div>
      <%= f.submit "送信", class: "btn btn-success" %>
    <% end %>
  </div>
</div>
